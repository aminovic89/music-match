{
  "expo": {
    "name": "Music Match",
    "slug": "music-match",
    "version": "1.0.0",
    "scheme": "musicmatch",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "icon": "./assets/ios-icon.png",
      "bundleIdentifier": "com.musicmatch.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.musicmatch.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-secure-store",
        {
          "faceIDPermission": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Music Match accède à tes photos pour que tu puisses choisir ta photo de profil.",
          "cameraPermission": "Music Match utilise ta caméra pour prendre ta photo de profil.",
          "microphonePermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#030712",
          "image": "./assets/splash-icon.png",
          "imageWidth": 120
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "e37596b6-acd7-42f1-ad21-dc48a8873163"
      }
    },
    "owner": "aminovic_89"
  }
}
