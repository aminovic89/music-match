# ================================
# Music Match — Variables PROD (Render + Neon + Vercel)
# API : à configurer dans Render > Environment
# Web : à configurer dans Vercel > Project Settings > Environment Variables
# ================================

NODE_ENV=production
PORT=3000

# Base de données PROD (connection string Neon)
DATABASE_URL=postgresql://user:password@ep-xxxx.region.aws.neon.tech/musicmatch?sslmode=require

# Redis — toujours pas utilisé par le code. À ajouter plus tard
# si besoin (ex: Upstash free tier) — REDIS_URL=...

# Auth — utiliser un secret fort et aléatoire en prod
JWT_SECRET=CHANGE_ME_USE_STRONG_RANDOM_SECRET_IN_PROD
JWT_EXPIRES_IN=7d
PASSWORD_RESET_TOKEN_TTL_MINUTES=60

# Vercel Blob (photos de profil) — token généré dans Vercel > Storage > Blob
BLOB_READ_WRITE_TOKEN=your_vercel_blob_token

# Resend (email — reset de mot de passe) — clé API dans Resend > API Keys
RESEND_API_KEY=your_resend_api_key
EMAIL_FROM=Music Match <onboarding@resend.dev>

# Spotify OAuth
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret
SPOTIFY_REDIRECT_URI=https://music-match-api-prod.onrender.com/api/auth/spotify/callback

# Deezer OAuth
DEEZER_CLIENT_ID=your_deezer_client_id
DEEZER_CLIENT_SECRET=your_deezer_client_secret
DEEZER_REDIRECT_URI=https://music-match-api-prod.onrender.com/api/auth/deezer/callback

# App — utilisé par l'API (CORS + socket.io) pour n'autoriser que le front Vercel
FRONTEND_URL=https://music-match.vercel.app

# Web (Vercel) — utilisé par apps/web pour appeler l'API
# NEXT_PUBLIC_API_URL=https://music-match-api-prod.onrender.com

# Matching
DEFAULT_MATCH_THRESHOLD=0.80
PREMIUM_MATCH_THRESHOLD=0.60
DAILY_MATCH_LIMIT=5
MESSAGE_TTL_HOURS=24
MATCH_EXPIRY_HOURS=48
